@using PayrollSystem.Application.DTOs.Employees
@model IEnumerable<EmployeeDto>

@{
    ViewData["Title"] = "إدارة الموظفين";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2><i class="fa-solid fa-user-tie"></i> إدارة الموظفين</h2>
    <a asp-action="Create" class="btn btn-primary">
        <i class="fa-solid fa-user-plus"></i> إضافة موظف جديد
    </a>
</div>

<div class="card shadow-sm">
    <div class="card-body">
        <table class="table table-hover table-bordered mb-0">
            <thead class="table-light">
                <tr>
                    <th>الاسم</th>
                    <th>القسم</th>
                    <th>الدرجة الوظيفية</th>
                    <th>تاريخ الميلاد</th>
                    <th>تاريخ التعيين</th>
                    <th style="width: 150px;">الإجراءات</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="5" class="text-center text-muted py-4">لا يوجد موظفين مسجلين حالياً.</td>
                    </tr>
                }
                else
                {
                    @foreach (var emp in Model)
                    {
                        <tr>
                            <td class="align-middle fw-bold">@emp.Name</td>
                            <td class="align-middle">@emp.DepartmentName</td>
                            <td class="align-middle">@emp.JobGradeName</td>
                            <td class="align-middle">@emp.DateOfBirth.ToString("yyyy-MM-dd")</td>
                            <td class="align-middle">@emp.HireDate.ToString("yyyy-MM-dd")</td>
                            <td class="text-center align-middle">
                                <div class="d-flex justify-content-center gap-2">
                                    <a asp-action="Edit" asp-route-id="@emp.Id" class="btn btn-sm btn-outline-secondary">
                                        <i class="fa-solid fa-pen-to-square ms-1"></i> تعديل
                                    </a>
                                    <form asp-action="Delete" asp-route-id="@emp.Id" method="post" class="m-0" onsubmit="return confirm('هل أنت متأكد من حذف هذا الموظف؟');">
                                        <button type="submit" class="btn btn-sm btn-outline-danger">
                                            <i class="fa-solid fa-trash ms-1"></i> حذف
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>