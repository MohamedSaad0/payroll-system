@using PayrollSystem.Application.DTOs.Departments
@model DepartmentFormDto

@{
    ViewData["Title"] = "تعديل قسم";
}

<div class="card shadow-sm mx-auto" style="max-width: 600px;">
    <div class="card-header bg-primary text-white">
        <h4 class="mb-0">تعديل بيانات القسم</h4>
    </div>
    <div class="card-body">
        <form asp-action="Edit" method="post" asp-antiforgery="true">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            <input type="hidden" asp-for="Id" />

            <div class="mb-3">
                <label asp-for="Name" class="form-label fw-bold"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger small"></span>
            </div>

            <div class="mb-4">
                <label asp-for="IncentivePercentage" class="form-label fw-bold"></label>
                <div class="input-group">
                    <input asp-for="IncentivePercentage" type="number" step="0.01" class="form-control" />
                    <span class="input-group-text">%</span>
                </div>
                <span asp-validation-for="IncentivePercentage" class="text-danger small"></span>
            </div>

            <div class="d-flex justify-content-between">
                <button type="submit" class="btn btn-success px-4">حفظ التعديلات</button>
                <a asp-action="Index" class="btn btn-secondary">إلغاء والعودة</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}