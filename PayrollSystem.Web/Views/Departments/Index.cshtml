@using PayrollSystem.Application.DTOs.Departments
@model IEnumerable<DepartmentDto>

@{
    ViewData["Title"] = "إدارة الأقسام";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2><i class="fa-solid fa-building"></i> إدارة الأقسام</h2>
    <a asp-action="Create" class="btn btn-primary">
        <i class="fa-solid fa-plus"></i> إضافة قسم جديد
    </a>
</div>

<div class="card shadow-sm">
    <div class="card-body">
        <table class="table table-hover table-bordered mb-0">
            <thead class="table-light">
                <tr>
                    <th>اسم القسم</th>
                    <th>نسبة الحافز (%)</th>
                    <th style="width: 150px;">الإجراءات</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="3" class="text-center text-muted py-4">لا توجد أقسام مسجلة حالياً.</td>
                    </tr>
                }
                else
                {
                    @foreach (var dept in Model)
                    {
                        <tr>
                            <td class="align-middle">@dept.Name</td>
                            <td class="align-middle">@dept.IncentivePercentage%</td>
                            <td class="text-center align-middle">
    <div class="d-flex justify-content-center gap-2">
        <a asp-action="Edit" asp-route-id="@dept.Id" class="btn btn-sm btn-outline-secondary">
            <i class="fa-solid fa-pen-to-square ms-1"></i> تعديل
        </a>
        
        <form asp-action="Delete" asp-route-id="@dept.Id" method="post" class="m-0" asp-antiforgery="true" onsubmit="return confirm('هل أنت متأكد من حذف هذا القسم؟');">
            <button type="submit" class="btn btn-sm btn-outline-danger">
                <i class="fa-solid fa-trash ms-1"></i> حذف
            </button>
        </form>
    </div>
</td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>