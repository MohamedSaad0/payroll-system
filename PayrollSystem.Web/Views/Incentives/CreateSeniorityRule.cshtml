@using PayrollSystem.Application.DTOs.Incentives
@model SeniorityIncentiveFormDto

@{
    ViewData["Title"] = "إضافة قاعدة حافز أقدمية";
}

<div class="card shadow-sm mx-auto border-success" style="max-width: 600px;">
    <div class="card-header bg-success text-white">
        <h4 class="mb-0">إضافة قاعدة جديدة لسنوات العمل</h4>
    </div>
    <div class="card-body">
        <form asp-action="CreateSeniorityRule" method="post" asp-antiforgery="true">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="MinYears" class="form-label fw-bold"></label>
                <div class="input-group">
                    <span class="input-group-text">أكثر من</span>
                    <input asp-for="MinYears" type="number" min="1" max="50" class="form-control" />
                    <span class="input-group-text">سنوات عمل</span>
                </div>
                <span asp-validation-for="MinYears" class="text-danger small"></span>
            </div>

            <div class="mb-4">
                <label asp-for="IncentivePercentage" class="form-label fw-bold"></label>
                <div class="input-group">
                    <input asp-for="IncentivePercentage" type="number" step="0.01" class="form-control" />
                    <span class="input-group-text">%</span>
                </div>
                <span asp-validation-for="IncentivePercentage" class="text-danger small"></span>
            </div>

            <div class="d-flex justify-content-between">
                <button type="submit" class="btn btn-success px-4">حفظ القاعدة</button>
                <a asp-action="Index" class="btn btn-secondary">إلغاء والعودة</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}