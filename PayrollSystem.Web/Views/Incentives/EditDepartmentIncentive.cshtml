@using PayrollSystem.Application.DTOs.Departments
@model DepartmentFormDto

@{
    ViewData["Title"] = "تعديل حافز القسم";
}

<div class="card shadow-sm mx-auto border-primary" style="max-width: 600px;">
    <div class="card-header bg-primary text-white">
        <h4 class="mb-0">تعديل نسبة الحافز الخاصة بالقسم</h4>
    </div>
    <div class="card-body">
        <form asp-action="EditDepartmentIncentive" method="post" asp-antiforgery="true">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            
            <input type="hidden" asp-for="Id" />

            <div class="mb-3">
                <label class="form-label fw-bold">اسم القسم</label>
                <!-- Disabled so it cannot be edited -->
                <input type="text" class="form-control bg-light" value="@Model.Name" disabled />
                <div class="form-text">لتعديل المسمى الخاص بالقسم، يرجى التوجه لشاشة "إدارة الأقسام".</div>
            </div>

            <div class="mb-4">
                <label asp-for="IncentivePercentage" class="form-label fw-bold"></label>
                <div class="input-group">
                    <input asp-for="IncentivePercentage" type="number" step="0.01" class="form-control" />
                    <span class="input-group-text">%</span>
                </div>
                <span asp-validation-for="IncentivePercentage" class="text-danger small"></span>
            </div>

            <div class="d-flex justify-content-between">
                <button type="submit" class="btn btn-primary px-4">حفظ التعديل</button>
                <a asp-action="Index" class="btn btn-secondary">إلغاء والعودة</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}