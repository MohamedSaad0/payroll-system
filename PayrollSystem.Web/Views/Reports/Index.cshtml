@using PayrollSystem.Application.DTOs.Reports
@model IEnumerable<PayrollReportDto>

@{
    ViewData["Title"] = "تقرير المرتبات";
}

<h2 class="mb-4"><i class="fa-solid fa-file-invoice-dollar"></i> لوحة التقارير الشاملة</h2>

<partial name="_ReportTabsPartial" />

<div class="card shadow-sm border-primary">
    <div class="card-header bg-primary text-white">
        <h5 class="mb-0">تقرير مرتبات العاملين - شهر @ViewBag.SelectedMonth لسنة @ViewBag.SelectedYear</h5>
    </div>
    <div class="card-body p-0">
        <table class="table table-hover table-bordered mb-0">
            <thead class="table-light">
                <tr>
                    <th>اسم الموظف</th>
                    <th>القسم</th>
                    <th>الدرجة</th>
                    <th>الأساسي</th>
                    <th class="text-success">إجمالي الحوافز</th>
                    <th class="text-danger">إجمالي الخصومات</th>
                    <th class="bg-warning">الصافي (Net Salary)</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr><td colspan="7" class="text-center py-4">لا توجد بيانات لهذا الشهر.</td></tr>
                }
                else
                {
                    @foreach (var rep in Model)
                    {
                        <tr>
                            <td class="align-middle fw-bold">@rep.EmployeeName</td>
                            <td class="align-middle">@rep.DepartmentName</td>
                            <td class="align-middle">@rep.JobGradeName</td>
                            <td class="align-middle">@rep.BaseSalary.ToString("N2")</td>
                            <td class="align-middle text-success">+@rep.TotalIncentives.ToString("N2")</td>
                            <td class="align-middle text-danger">-@rep.AbsenceDeductionAmount.ToString("N2")</td>
                            <td class="align-middle fw-bold bg-light">@rep.NetSalary.ToString("N2") جنيه</td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>