@using PayrollSystem.Application.DTOs.Reports
@model IEnumerable<EmployeeReportDto>

@{
    ViewData["Title"] = "تقرير العاملين";
}

<h2 class="mb-4"><i class="fa-solid fa-file-invoice-dollar"></i> لوحة التقارير الشاملة</h2>

<partial name="_ReportTabsPartial" />

<div class="card shadow-sm border-secondary">
    <div class="card-header bg-secondary text-white">
        <h5 class="mb-0">سجل بيانات العاملين الأساسية</h5>
    </div>
    <div class="card-body p-0">
        <table class="table table-hover table-bordered mb-0">
            <thead class="table-light">
                <tr>
                    <th>الاسم</th>
                    <th>القسم</th>
                    <th>الدرجة الوظيفية</th>
                    <th>الراتب الأساسي</th>
                    <th>تاريخ الميلاد</th>
                    <th>تاريخ التعيين</th>
                    <th>رقم الهاتف</th>
                    <th>البريد الإلكتروني</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr><td colspan="7" class="text-center py-4">لا يوجد موظفين مسجلين.</td></tr>
                }
                else
                {
                    @foreach (var emp in Model)
                    {
                        <tr>
                            <td class="align-middle fw-bold">@emp.Name</td>
                            <td class="align-middle">@emp.DepartmentName</td>
                            <td class="align-middle">@emp.JobGradeName</td>
                            <td class="align-middle">@emp.BaseSalary.ToString("N2")</td>
                            <td class="align-middle">@emp.DateOfBirth.ToString("yyyy-MM-dd")</td>
                            <td class="align-middle">@emp.HireDate.ToString("yyyy-MM-dd")</td>
                            <td class="align-middle" dir="ltr">@emp.PhoneNumber</td>
                            <td class="align-middle">@emp.Email</td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>