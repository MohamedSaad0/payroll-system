@using PayrollSystem.Application.DTOs.Attendance
@model AbsencePolicyFormDto

@{
    ViewData["Title"] = "تعديل سياسة الحضور";
}

<div class="card shadow-sm mx-auto border-primary" style="max-width: 600px;">
    <div class="card-header bg-primary text-white">
        <h4 class="mb-0">تعديل نسبة الحافز / الخصم</h4>
    </div>
    <div class="card-body">
        <form asp-action="EditPolicy" method="post" asp-antiforgery="true">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            
            <input type="hidden" asp-for="Id" />

            <div class="mb-3">
                <label class="form-label fw-bold">الحالة (أيام الغياب)</label>
                <input type="text" class="form-control bg-light" value="@Model.Bracket" disabled />
                <div class="form-text">هذه الحالة ثابتة حسب لوائح الشركة ولا يمكن تغيير مسماها.</div>
            </div>

            <div class="mb-4">
                <label asp-for="Percentage" class="form-label fw-bold"></label>
                <div class="input-group">
                    <input asp-for="Percentage" type="number" step="0.01" class="form-control" />
                    <span class="input-group-text">%</span>
                </div>
                <span asp-validation-for="Percentage" class="text-danger small"></span>
            </div>

            <div class="d-flex justify-content-between">
                <button type="submit" class="btn btn-primary px-4">حفظ التعديل</button>
                <a asp-action="Index" class="btn btn-secondary">إلغاء والعودة</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}