@using PayrollSystem.Application.DTOs.Attendance
@model EmployeeAbsenceFormDto

@{
    ViewData["Title"] = "تسجيل غياب جديد";
}

<div class="card shadow-sm mx-auto border-danger" style="max-width: 600px;">
    <div class="card-header bg-danger text-white">
        <h4 class="mb-0"><i class="fa-solid fa-user-clock"></i> تسجيل أيام الغياب الشهرية</h4>
    </div>
    <div class="card-body">
        <form asp-action="RecordAbsence" method="post" asp-antiforgery="true">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="mb-4">
                <label asp-for="EmployeeId" class="form-label fw-bold"></label>
                <select asp-for="EmployeeId" class="form-select" asp-items="ViewBag.Employees">
                    <option value="">-- اختر الموظف --</option>
                </select>
                <span asp-validation-for="EmployeeId" class="text-danger small"></span>
            </div>

            <div class="row mb-3">
                <div class="col-md-6">
                    <label asp-for="Year" class="form-label fw-bold"></label>
                    <input asp-for="Year" type="number" class="form-control" />
                    <span asp-validation-for="Year" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Month" class="form-label fw-bold"></label>
                    <select asp-for="Month" class="form-select">
                        @for (int i = 1; i <= 12; i++)
                        {
                            <option value="@i">@i</option>
                        }
                    </select>
                    <span asp-validation-for="Month" class="text-danger small"></span>
                </div>
            </div>

            <div class="mb-4">
                <label asp-for="AbsenceDaysCount" class="form-label fw-bold"></label>
                <div class="input-group">
                    <input asp-for="AbsenceDaysCount" type="number" min="0" max="31" class="form-control" />
                    <span class="input-group-text">أيام</span>
                </div>
                <span asp-validation-for="AbsenceDaysCount" class="text-danger small"></span>
            </div>

            <div class="d-flex justify-content-between">
                <button type="submit" class="btn btn-danger px-4">تسجيل السجل</button>
                <a asp-action="Index" class="btn btn-secondary">إلغاء والعودة</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}